# Copy to .ios_build.env and fill in your project values.
# .ios_build.env is ignored by git because it contains local credentials.

SUPABASE_URL="YOUR_SUPABASE_URL_HERE"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY_HERE"

# Usually "ios" works when one iPhone is connected.
# If Flutter reports multiple devices, set this to the exact device id from:
#   /Users/dungkimhuynh/Development/flutter_sdk/bin/flutter devices
DEVICE_ID="ios"

# Optional. The script auto-detects this path when empty.
FLUTTER_BIN=""

# release is what you want for installing on a real iPhone.
BUILD_MODE="release"
