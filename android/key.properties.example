# Copy this file to android/key.properties. Never commit key.properties or a keystore.
# Generate the upload key once, store it safely, and use the same key for every update.
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=aetron_upload
# Path is resolved from android/app. This example expects the keystore in android/.
storeFile=../aetron-upload.jks
